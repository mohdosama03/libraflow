NODE_ENV=development
PORT=5000

# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/libraflow

# Use a long, random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Late return fine, in rupees per day
FINE_PER_DAY=5

# Default borrowing period, in days
BORROW_DAYS=14

# Max books a student can hold at once
MAX_BOOKS_PER_STUDENT=5
